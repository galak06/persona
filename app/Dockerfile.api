# Persona — API image
# Python 3.11 slim. FastAPI routes only — no browser automation, so unlike
# Dockerfile.worker this image skips the Playwright/Chromium install and the
# ffmpeg/build-dep layers (smaller, faster build).
#
#   api → uvicorn api.approval_api:app

FROM python:3.11-slim

# curl is kept for the container healthcheck (GET /api/v1/health); everything
# else the worker image needs (ffmpeg, gcc, libc6-dev, libffi-dev, libssl-dev,
# Playwright/Chromium) is intentionally omitted — the API never launches a
# browser, and while it does subprocess-invoke recipe-publisher's reel
# *publish* worker (uploading already-composed mp4s to IG/FB, see
# api/ideas_api.py::_publish_reel_background), that path is pure httpx/API
# calls, no ffmpeg/video composition involved (that happens on the host,
# via scripts/crewai_reels_pipeline.py, before a reel ever reaches review).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer-cached until requirements change)
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt 2>/dev/null || \
    pip install --no-cache-dir -r requirements.txt

# Copy project source
COPY . .

# Non-root user for security
RUN useradd -m -u 1000 persona && chown -R persona:persona /app
USER persona

# Build provenance: the commit this image was built from. `scripts/sync.sh`
# passes it and then reads it back out of the running container, so "is the
# stack running current code?" is one command instead of grepping for a line
# you happen to remember changing.
#
# Declared last on purpose: the SHA changes on every commit, so an earlier
# placement would invalidate the dependency layers on every single build.
ARG PERSONA_GIT_SHA=unknown
ENV PERSONA_GIT_SHA=$PERSONA_GIT_SHA

# Default: run the API.
CMD ["uvicorn", "api.approval_api:app", "--host", "0.0.0.0", "--port", "5001", "--reload"]
