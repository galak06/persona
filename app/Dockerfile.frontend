# Persona — Frontend image (Vite/React)
# Multi-stage: build → serve with nginx

FROM node:20-slim AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Serve with nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# Proxy /api → api:5001
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Build provenance -- see Dockerfile.api. Declared in the final stage so
# `sync.sh` can read it back out of the running nginx container.
ARG PERSONA_GIT_SHA=unknown
ENV PERSONA_GIT_SHA=$PERSONA_GIT_SHA

EXPOSE 80
