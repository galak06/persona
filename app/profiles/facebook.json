{
  "platform": "facebook",
  "rate_limits": {
    "page_posts_per_day": 3,
    "group_posts_per_day": 10,
    "comments_per_day": 5,
    "likes_per_day": 5,
    "group_visits_per_day": 6,
    "group_join_requests_per_week": 15,
    "group_join_requests_per_day": 5,
    "delay_between_comments": "30-120s random",
    "delay_between_group_visits": "45-180s random",
    "delay_between_likes": "30-90s random"
  },
  "flows": [
    {
      "id": "fb-engager",
      "skill": "fb-engager",
      "script": "scripts/fb_engager.py",
      "description": "Scan joined Facebook groups, like qualifying posts, draft and post a comment inline (single-pass)",
      "schedule": {
        "cron": "33 15 * * *",
        "cadence": "daily"
      },
      "re_run_guard": true,
      "requires_browser": true,
      "requires_approval": false,
      "telegram_notify": true,
      "timeout_minutes": 30,
      "rate_limits": {
        "likes_per_day": 5,
        "comments_per_day": 5
      },
      "order": 25,
      "depends_on": [
        "site-analyzer"
      ],
      "inputs": [
        {
          "path": "data/site_content_cache.json",
          "min_count": 1,
          "max_age_hours": 26,
          "produced_by": "site-analyzer"
        }
      ]
    },
    {
      "id": "fb-group-scout",
      "skill": "fb-group-scout",
      "script": "scripts/fb_group_scout.py",
      "description": "Search Facebook for new dog groups (public + private) to join, score and present for approval",
      "schedule": {
        "cron": "3 15 * * 0",
        "cadence": "weekly",
        "next_run": "2026-05-17"
      },
      "output_file": ".claude/state/pending_groups.json",
      "re_run_guard": true,
      "re_run_cadence": "weekly",
      "requires_browser": true,
      "requires_approval": true,
      "approval_channel": "telegram",
      "telegram_notify": true,
      "rate_limits": {
        "join_requests_per_week": 15
      },
      "order": 100,
      "depends_on": [],
      "inputs": []
    },
    {
      "id": "fb-group-distribute",
      "skill": "fb-group-publisher",
      "script": "scripts/distribute_fb_groups.py",
      "description": "Daily distribute published WP posts to eligible FB groups (browser-based)",
      "schedule": {
        "cron": "30 17 * * *",
        "cadence": "daily"
      },
      "output_file": "logs/engagement_log.jsonl",
      "re_run_guard": true,
      "requires_browser": true,
      "requires_approval": true,
      "approval_channel": "telegram",
      "telegram_notify": true,
      "rate_limits": {
        "group_posts_per_day": 10
      },
      "order": 110,
      "depends_on": [
        "content-publish"
      ],
      "inputs": []
    },
    {
      "id": "fb-notification-scan",
      "skill": "fb-notification-scan",
      "script": "scripts/fb_notification_scan.py",
      "description": "Weekly Facebook notification sweep — surface group activity worth a follow-up reply",
      "schedule": {
        "cron": "0 9 * * 0",
        "cadence": "weekly"
      },
      "output_file": null,
      "re_run_guard": true,
      "requires_browser": true,
      "requires_approval": false,
      "telegram_notify": true,
      "order": 115,
      "depends_on": [],
      "inputs": []
    }
  ],
  "_notes": "Slice B: flows[] added. fb-group-distribute orphan fix: depends_on now [content-publish] (was []). fb-engager (single-pass scan->like->comment) is the SOLE Facebook engagement flow, cron 33 15 * * * daily; the fb-scanner+fb-comment pair is retired and their entries deleted. Schedule edits go HERE, never in the generated data/schedule.json -- every profiles_build run regenerates that artifact and silently reverts direct edits to it."
}
